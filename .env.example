# Copy to .env.local for local development, or add these in Vercel Settings.
# Google OAuth web application credentials (server-only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in Google Cloud.
# Local: http://localhost:3000/api/shortcut-admin/callback
GOOGLE_REDIRECT_URI=
# Optional one-time setup hint. Authorization still uses GOOGLE_ADMIN_SUB.
GOOGLE_ADMIN_EMAIL_HINT=
# Exact Google account ID (sub). Leave empty for first verified ID lookup;
# no administrator session is issued until this is configured.
GOOGLE_ADMIN_SUB=
# Independent random secret, at least 32 characters. Rotate to invalidate sessions.
ADMIN_SESSION_SECRET=
# Connect a PUBLIC Vercel Blob store and use its read-write token.
BLOB_READ_WRITE_TOKEN=

# For persistent storage on this PC (not Vercel):
# SHORTCUT_STORAGE=local

# Public canonical origin, e.g. https://your-domain.com (no path/query).
# Set before building; falls back to VERCEL_PROJECT_PRODUCTION_URL on Vercel.
SITE_URL=
